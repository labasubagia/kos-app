{
  "name": "kos-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && oxvelte lint \"src/**/*.svelte\"",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  },
  "devDependencies": {
    "@billpeet/oxvelte": "^0.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.81.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.22.0",
    "cn": "^0.5.2",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "shadcn-svelte": "^1.8.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
